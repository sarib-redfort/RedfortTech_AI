# Leave VITE_API_URL unset in development: the Vite dev server proxies
# /api/v1/public -> http://localhost:5000 (see vite.config.ts), so the site
# talks to the backend same-origin and never hits CORS.
#
# For a production build, point this at the deployed backend, e.g.:
# VITE_API_URL="https://api.redforttech.ai/api/v1/public"

# If port 5000 is taken, point the dev proxy somewhere else:
# API_PORT=5055
# API_ORIGIN="http://localhost:5055"
