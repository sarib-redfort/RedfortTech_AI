# ─────────────────────────────────────────────────────────────
# Database (Neon PostgreSQL)
# ─────────────────────────────────────────────────────────────
# NOTE: connect_timeout is raised because Neon auto-suspends idle databases;
# a cold start can exceed Prisma's 5s default and fail boot with P1001.
# NOTE: `schema=redfort_app` isolates this codebase's tables from the pre-existing
# `public` schema, which was created by a DIFFERENT/older version of this backend
# (snake_case columns, extra tables like resources/trusted_companies) and is NOT
# compatible with prisma/schema.prisma. A JSON backup of `public` is in
# ../backups/neon-public-schema-backup.json. See README "Database state".
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&connect_timeout=30"

# ─────────────────────────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────────────────────────
# Must be at least 32 characters; the API refuses to boot otherwise.
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
PORT=5000

# Public origin of the website. Used to build absolute URLs in sitemap.xml.
SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# CORS — comma-separated list of allowed frontend origins
# 3000 = public website, 3001 = CMS admin panel
# ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─────────────────────────────────────────────────────────────
# Cloudinary (image uploads)
# ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME='your-cloud-name'
CLOUDINARY_API_KEY='your-api-key'
CLOUDINARY_API_SECRET='your-api-secret'

# ─────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────
# Swagger is served automatically outside production. Set this to expose
# /api/docs in a production build as well.
# ENABLE_SWAGGER=false
