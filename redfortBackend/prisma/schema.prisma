generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Admin
  ContentWriter
}

enum Status {
  Active
  Inactive
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ContentWriter)
  status    Status   @default(Active)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
  @@map("users")
}

model Blog {
  id              String   @id @default(uuid())

  title           String
  slug            String   @unique

  category        String

  image           String?

  content         String   @db.Text

  createdBy       String?

  authorName      String?

  metaTitle       String?
  metaDescription String? @db.Text

  status          Status   @default(Active)

  publishedAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([status])

  @@map("blogs")
}

model CaseStudy {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  image            String?
  shortDescription String   @db.Text
  content          String   @db.Text
  technologies     String[]
  status           Status   @default(Active)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@map("case_studies")
}

model Service {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  icon        String?
  status      Status   @default(Active)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  faqs        FAQ[]

  @@index([status])
  @@map("services")
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String?
  company   String?
  avatar    String?
  rating    Int      @default(5)
  message   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

enum ContactStatus {
  Unread
  Read
  Replied
}

model Contact {
  id          String        @id @default(uuid())
  name        String
  email       String
  phoneNumber String?
  subject     String?
  message     String        @db.Text
  status      ContactStatus @default(Unread)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@map("contacts")
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String   @db.Text
  page      String
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  status    Status   @default(Active)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([page])
  @@index([serviceId])
  @@map("faqs")
}

model Homepage {
  id                 String   @id @default(uuid())
  heroTitle          String?
  heroDescription    String?  @db.Text
  heroImage          String?
  buttonText         String?
  happyClients       Int      @default(0)
  industriesServed   Int      @default(0)
  yearsExperience    Int      @default(0)
  clientSatisfaction Int      @default(0)
  updatedAt          DateTime @updatedAt

  @@map("homepage")
}

model About {
  id          String   @id @default(uuid())
  title       String?
  description String?  @db.Text
  image       String?
  updatedAt   DateTime @updatedAt

  @@map("about")
}

model Settings {
  id         String   @id @default(uuid())
  siteName   String?
  siteEmail  String?
  sitePhone  String?
  address    String?  @db.Text
  theme      String?
  logoUrl    String?
  facebook   String?
  twitter    String?
  linkedin   String?
  instagram  String?
  updatedAt  DateTime @updatedAt

  @@map("settings")
}

model Industry {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  image           String?
  description     String   @db.Text
  segmentBenefits String[]
  icon            String?
  status          Status   @default(Active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@map("industries")
}

model TeamMember {
  id           String   @id @default(uuid())
  image        String?
  name         String
  role         String
  description  String   @db.Text
  linkedinUrl  String?
  twitterUrl   String?
  status       Status   @default(Active)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([displayOrder])
  @@map("team_members")
}
